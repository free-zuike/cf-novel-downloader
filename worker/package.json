{
  "name": "novel-downloader-worker",
  "version": "1.0.0",
  "private": true,
  "description": "Novel Downloader - Cloudflare Workers",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "wrangler types",
    "db:init": "wrangler d1 execute novel-db --local --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute novel-db --remote --file=./schema.sql",
    "tail": "wrangler tail"
  },
  "dependencies": {
    "hono": "^4.4.7",
    "cheerio": "^1.0.0-rc.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240620.0",
    "wrangler": "^3.60.0",
    "typescript": "^5.4.5"
  }
}
